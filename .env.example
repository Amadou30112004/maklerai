# Kopieren nach .env.local und ausfüllen. Später dieselben Werte bei Vercel eintragen.

# URL der Google-Apps-Script-Web-App (siehe docs/google-apps-script.gs und README).
# Ohne URL werden Anfragen nur in der Entwicklung lokal in data/pilot-anfragen.json gespeichert.
GOOGLE_SHEETS_WEBHOOK_URL=

# Gemeinsamer geheimer Schlüssel, frei wählbar, mindestens 32 Zeichen.
# Muss genau so im Apps Script als SECRET stehen.
GOOGLE_SHEETS_SECRET=
